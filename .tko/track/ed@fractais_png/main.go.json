            "label": "2026-04-08_17-32-39",
            "content": "package main\n\nimport (\n\t\"fmt\"\n\t\"math/rand\"\n)\n\nfunc ri(inf, sup int) float64 {\n\treturn float64(rand.Intn(sup-inf+1) + inf)\n}\n\nfunc arvore(pen *Pen, dist float64) {\n\tif dist < 5 {\n\t\treturn\n\t}\n\n\tangulo_direita := ri(15, 30)\n\tangulo_esquerda := ri(15, 30)\n\n\tpen.SetLineWidth(dist / 40)\n\tpen.Walk(dist)\n\tpen.Right(angulo_direita)\n\tarvore(pen, dist * (ri(82, 85)/100.0))\n\tpen.Left(angulo_direita + angulo_esquerda)\n\tarvore(pen, dist * (ri(82, 85)/100.0))\n\tpen.Right(angulo_esquerda)\n\tpen.Walk(-dist)\n}\n\nfunc main() {\n\tpen := NewPen(500, 500)\n\tpen.SetHeading(90)\n\tpen.SetPosition(250, 450)\n\tarvore(pen, 65)\n\tpen.SavePNG(\"tree.png\")\n\tfmt.Println(\"PNG file created successfully.\")\n}\n",
