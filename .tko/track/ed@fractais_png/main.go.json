            "label": "2026-04-12_11-01-58",
            "content": "package main\n\nimport (\n\t\"fmt\"\n\t\"math/rand\"\n)\n\nfunc ri(inf, sup int) float64 {\n\treturn float64(rand.Intn(sup-inf+1) + inf)\n}\n\nfunc quadrados(pen *Pen, dist_lado float64) {\n\tif dist_lado < 5 {\n\t\treturn\n\t}\n\t\n\tpen.SetLineWidth(1)\n\tpen.Up()\n\tpen.Walk(dist_lado)\n\tpen.Right(90)\n\tpen.Walk(dist_lado)\n\tpen.Down()\n\n\tfor i := 0; i < 4; i++ {\n\t\tquadrados(pen, dist_lado / 2.0)\n\n\t\tpen.Right(90)\n\t\tpen.Walk(dist_lado)\n\t}\n\n\tpen.Up()\n\tpen.Right(180)\n\tpen.Walk(dist_lado / 2.0)\n\tpen.Right(90)\n\tpen.Walk(dist_lado / 2.0)\n\tpen.Left(180)\n\tpen.Down()\n\n}\n\nfunc main() {\n\tpen := NewPen(500, 500)\n\tpen.SetHeading(90)\n\tpen.SetPosition(250, 250)\n\tquadrados(pen, 200)\n\tpen.SavePNG(\"tree.png\")\n\tfmt.Println(\"PNG file created successfully.\")\n}\n",
            "lines": "48"
        }
