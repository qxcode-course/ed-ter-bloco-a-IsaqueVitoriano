            "label": "2026-04-08_16-13-19",
            "content": "package main\n\nimport (\n\t\"fmt\"\n\t\"math/rand\"\n)\n\nfunc ri(inf, sup int) float64 {\n\treturn float64(rand.Intn(sup-inf+1) + inf)\n}\n\nfunc embua(pen *Pen, dist float64) {\n\tif dist < 5 {\n\t\treturn\n\t}\n\n\tpen.SetLineWidth(dist / 45)\n\tpen.Walk(dist)\n\tpen.Right(90)\n\tdist *= 0.97\n\n\tembua(pen, dist)\n}\n\nfunc main() {\n\tpen := NewPen(800, 800)\n\tpen.SetHeading(0)\n\tpen.SetPosition(200, 200)\n\tembua(pen, 400)\n\tpen.SavePNG(\"tree.png\")\n\tfmt.Println(\"PNG file created successfully.\")\n}\n",
